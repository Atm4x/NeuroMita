{
  "schema_version": 1,
  "id": "openai-responses",
  "revision": 1,
  "title": {"ru": "OpenAI Responses (API-ключ)", "en": "OpenAI Responses (API key)"},
  "description": {
    "ru": "Настройки принадлежат этому пресету. Выключенные параметры не отправляются. Доступность параметров зависит от модели и сервера Responses.",
    "en": "Settings belong to this preset. Unchecked parameters are omitted. Parameter availability depends on the model and Responses server."
  },
  "dialect": "openai_responses",
  "supports": {"structured_output": true, "tools_native": true, "streaming": true},
  "documentation_url": "https://developers.openai.com/api/reference/python/resources/responses/methods/create",
  "fields": [
    {
      "id": "temperature",
      "title": {"ru": "Температура", "en": "Temperature"},
      "type": "number",
      "path": ["temperature"],
      "default": 1.0,
      "enabled_by_default": false,
      "minimum": 0,
      "maximum": 2
    },
    {
      "id": "max_tokens",
      "title": {"ru": "Макс. токенов ответа", "en": "Max output tokens"},
      "description": {
        "ru": "Общий лимит токенов ответа, включая рассуждения.",
        "en": "Total output token limit, including reasoning."
      },
      "type": "integer",
      "path": ["max_output_tokens"],
      "default": 2500,
      "enabled_by_default": false,
      "minimum": 16
    },
    {
      "id": "top_p",
      "title": {"ru": "Top-P", "en": "Top-P"},
      "type": "number",
      "path": ["top_p"],
      "default": 1.0,
      "enabled_by_default": false,
      "minimum": 0,
      "maximum": 1
    },
    {
      "id": "reasoning_effort",
      "title": {"ru": "Усилие рассуждения", "en": "Reasoning effort"},
      "type": "string",
      "path": ["reasoning", "effort"],
      "enum": ["none", "minimal", "low", "medium", "high", "xhigh"],
      "default": "medium",
      "enabled_by_default": false
    },
    {
      "id": "reasoning_summary",
      "title": {"ru": "Краткое изложение рассуждений", "en": "Reasoning summary"},
      "type": "string",
      "path": ["reasoning", "summary"],
      "enum": ["auto", "concise", "detailed"],
      "default": "auto",
      "enabled_by_default": false
    },
    {
      "id": "verbosity",
      "title": {"ru": "Подробность ответа", "en": "Response verbosity"},
      "type": "string",
      "path": ["text", "verbosity"],
      "enum": ["low", "medium", "high"],
      "default": "medium",
      "enabled_by_default": false
    }
  ]
}
