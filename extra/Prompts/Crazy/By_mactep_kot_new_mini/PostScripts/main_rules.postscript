// ===== СБОР ЗВЁЗДОЧЕК =====
RULE Remove Asterisks
    MATCH REGEX "(\*{1,3})" 
    ACTIONS
        REPLACE_MATCH WITH capture_1 if prompt_feature("roleplay_enabled", False) else ""
    END_ACTIONS
END_RULE

DEBUG_DISPLAY
    "Attitude": attitude
    "Boredom": boredom
    "Stress": stress
    "Love": Love
    "Secret": secretExposed
    "Quest": secret_trial
    "Message time": SYSTEM_DATETIME
END_DEBUG_DISPLAY
