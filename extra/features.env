EXPERIMENTAL_FUNCTIONS=1

# --- Автообновление ---
# Контур обновлений: test | release. Пока дефолт на test для контура разработки.
UPDATE_CONTOUR=test
# Публичный репозиторий релизного контура.
UPDATE_REPO_RELEASE=VinerX/NeuroMita
# Репозиторий тестового контура.
UPDATE_REPO_TEST=Atm4x/NeuroMita
# Legacy fallback для старых сборок, которые ещё читают только UPDATE_REPO.
UPDATE_REPO=Atm4x/NeuroMita
# 0 — только уведомление о новой версии, 1 — скачать и применить автоматически
AUTO_UPDATE=0
